digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.65, pad=0.15, bgcolor="white"];
  node [shape=box, style="rounded,filled", fillcolor="#F8F8F8", color="#333333", fontname="Helvetica", fontsize=12, margin="0.12,0.07"];
  edge [color="#333333", arrowsize=0.8, penwidth=1.2];

  citizen [label="Citizen User\nsubmits complaint text\nand tracks complaint status", fillcolor="#EAF2FF"];
  admin [label="Barangay Administrator\nreviews AI decision\nand manages case status", fillcolor="#EAF2FF"];
  web [label="Next.js / TypeScript Interface\nCitizen Portal + Admin Dashboard"];
  api [label="FastAPI Backend\nvalidation, routing, authentication, logging"];

  subgraph cluster_services {
    label="Core Services";
    fontsize=14; fontname="Helvetica-Bold"; color="#7A7A7A"; style="rounded";
    infer [label="Inference Service\nload TF-IDF vectorizer\nload trained SVM model"];
    review [label="Review and Feedback Service\nstore machine prediction\nstore administrator confirmation or correction"];
  }

  subgraph cluster_store {
    label="Storage and Model Assets";
    fontsize=14; fontname="Helvetica-Bold"; color="#7A7A7A"; style="rounded";
    db [label="PostgreSQL Database\ncomplaints, predictions, decisions,\nstates, audit trail", fillcolor="#F5FFF0"];
    registry [label="Versioned Model Artifacts\nTF-IDF vectorizer + SVM model", fillcolor="#F5FFF0"];
    offline [label="Offline Training Workspace\ncurated feedback + evaluation\nbefore future release", fillcolor="#FFF8E8"];
  }

  {rank=same; citizen admin}
  {rank=same; infer review}
  {rank=same; db registry offline}

  citizen -> web;
  admin -> web;
  web -> api;
  api -> infer;
  api -> review;
  infer -> registry;
  infer -> db;
  review -> db;
  review -> offline;
  offline -> registry;
  db -> web [dir=back];
}
