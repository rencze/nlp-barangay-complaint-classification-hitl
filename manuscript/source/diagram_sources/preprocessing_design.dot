digraph G{graph[rankdir=LR,bgcolor="white",pad=.24,nodesep=.32,ranksep=.42,fontsize=14,fontname="Helvetica",label="TEXT REPRESENTATION INSIDE TRAINING FOLDS",labelloc=t];node[shape=box,style="rounded,filled",fillcolor="#EEF5FA",color="#4B6575",fontname="Helvetica",fontsize=10.5,margin=".14,.11"];edge[color="#52718A",arrowsize=.6];a[label="Citizen text\nBisaya / Filipino / English / mixed"];b[label="Conservative text cleaning\nNo automatic loss of complaint meaning"];c[label="TF-IDF word tokenization\nLearn vocabulary ONLY on train fold"];d[label="Sparse feature vectors\nNo category or source metadata"];e[label="LinearSVC / Naive Bayes\nThree provisional text classes"];a->b->c->d->e;}
