digraph G{graph[rankdir=LR,bgcolor="white",nodesep=.45,ranksep=.48,pad=.2,fontname="Helvetica",fontsize=16,label="COMPLAINT WORKFLOW STATES (NOT MODEL CLASSES)",labelloc=t];node[shape=box,style="rounded,filled",fillcolor="#EFF4FA",color="#4B6575",fontname="Helvetica",fontsize=11,margin=".18,.10"];edge[color="#52718A",arrowsize=.65,fontname="Helvetica",fontsize=10];sub[label="Submitted"];rev[label="Pending human review"];ack[label="Acknowledged"];active[label="In progress"];resolved[label="Resolved"];closed[label="Closed",fillcolor="#E2F3E9",color="#3C7C57"];clarify[label="Clarification requested",fillcolor="#FFF4E6",color="#A77A34"];escal[label="Referred / escalated",fillcolor="#FFF0E7",color="#A86B52"];sub->rev;rev->ack[label="reviewed"];rev->clarify[label="needs info"];clarify->rev[label="new details"];rev->escal[label="safety / jurisdiction"];escal->ack[label="tracked referral"];ack->active->resolved->closed;resolved->active[label="reopened"];}
